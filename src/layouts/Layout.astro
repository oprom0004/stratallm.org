---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const { title, description, canonical, schema } = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, 'https://stratallm.org').href;
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: '🚀 Quickstart', href: '/docs/quickstart/' },
  { name: '🧠 Supported Models', href: '/docs/models/' },
  { name: '🔌 OpenAI / API', href: '/docs/api/' },
  { name: '📊 Benchmarks', href: '/#benchmarks' },
  { name: '🛠️ Troubleshooting', href: '/docs/troubleshooting/' },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-strata-void text-slate-100 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://stratallm.org/images/strata-og.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://stratallm.org/images/strata-og.jpg" />

    <!-- Structured Data -->
    {schema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(Array.isArray(schema) ? schema : [schema])}
      />
    )}
  </head>
  <body class="min-h-screen flex flex-col font-sans selection:bg-strata-cyan selection:text-black">
    
    <!-- Top Announcement Bar -->
    <div class="bg-gradient-to-r from-strata-card via-strata-border to-strata-card border-b border-strata-border text-[11px] sm:text-xs py-1.5 px-4 text-center text-slate-300 font-mono">
      <span class="inline-block px-1.5 py-0.5 rounded bg-strata-cyan/20 text-strata-cyan font-bold mr-2">OPEN SOURCE</span>
      Strata Engine by Niko1221 • Run 125B+ MoE Models (Qwen3.8-Flash-Next) on 12GB VRAM GPUs!
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-strata-void/90 border-b border-strata-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-strata-cyan to-blue-600 flex items-center justify-center text-lg shadow-glow-cyan group-hover:scale-105 transition-transform">
            ⚡
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-mono font-black text-lg text-white tracking-tight">STRATA</span>
              <span class="text-xs font-mono px-1.5 py-0.2 rounded bg-strata-cyan/15 text-strata-cyan border border-strata-cyan/30">LLM</span>
            </div>
            <span class="hidden sm:block text-[10px] font-mono text-strata-muted tracking-wider uppercase">
              Consumer MoE Inference Engine
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden lg:flex items-center gap-1 xl:gap-2 font-mono text-xs uppercase tracking-wider font-semibold">
          {navLinks.map((link) => {
            const isActive = currentPath === link.href;
            return (
              <a
                href={link.href}
                class={`px-3 py-2 rounded-lg transition-all ${
                  isActive
                    ? 'bg-strata-card text-strata-cyan border border-strata-cyan/40 shadow-sm'
                    : 'text-slate-300 hover:text-white hover:bg-strata-card/60'
                }`}
              >
                {link.name}
              </a>
            );
          })}
        </nav>

        <!-- GitHub / Quick Install Action -->
        <div class="flex items-center gap-2">
          <a
            href="https://github.com/Niko1221/Strata"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:flex items-center gap-1.5 px-3 py-2 rounded-lg bg-strata-card hover:bg-slate-800 border border-strata-border text-white font-mono text-xs uppercase tracking-wider transition-all"
          >
            <span>⭐ Star on GitHub</span>
          </a>
          <a
            href="/docs/quickstart/"
            class="px-4 py-2 rounded-lg bg-gradient-to-r from-strata-cyan to-blue-500 text-black font-mono font-bold text-xs uppercase tracking-wider shadow-glow-cyan hover:brightness-110 transition-all flex items-center gap-1.5"
          >
            <span>Get Started</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="border-t border-strata-border bg-strata-card/70 mt-20 font-sans text-xs text-strata-muted">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
          
          <div class="space-y-3 md:col-span-1">
            <div class="flex items-center gap-2">
              <span class="text-lg">⚡</span>
              <span class="font-mono font-black text-white text-base">Strata LLM</span>
            </div>
            <p class="leading-relaxed">
              Open-source local inference engine developed by Niko1221. Empowering developers and creators to run massive Mixture-of-Experts AI models on consumer gaming PCs without multi-GPU clusters.
            </p>
            <div class="pt-1">
              <a
                href="https://github.com/Niko1221/Strata"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-strata-cyan hover:underline font-mono text-xs"
              >
                <span>GitHub Repository: Niko1221/Strata</span>
                <span>↗</span>
              </a>
            </div>
          </div>

          <div>
            <h4 class="font-mono font-bold text-white text-xs uppercase tracking-wider mb-3">Documentation</h4>
            <ul class="space-y-2">
              <li><a href="/docs/quickstart/" class="hover:text-strata-cyan transition-colors">Windows START-HERE Setup</a></li>
              <li><a href="/docs/quickstart/#linux" class="hover:text-strata-cyan transition-colors">Linux &amp; WSL2 Guide</a></li>
              <li><a href="/docs/models/" class="hover:text-strata-cyan transition-colors">Supported Models Matrix</a></li>
              <li><a href="/docs/api/" class="hover:text-strata-cyan transition-colors">OpenAI / Anthropic API Spec</a></li>
              <li><a href="/docs/troubleshooting/" class="hover:text-strata-cyan transition-colors">Troubleshooting &amp; OOM Fixes</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-mono font-bold text-white text-xs uppercase tracking-wider mb-3">Community Integrations</h4>
            <ul class="space-y-2">
              <li><a href="/docs/api/#continue" class="hover:text-strata-cyan transition-colors">Continue.dev IDE Assistant</a></li>
              <li><a href="/docs/api/#cursor" class="hover:text-strata-cyan transition-colors">Cursor AI Local Engine</a></li>
              <li><a href="/docs/api/#openwebui" class="hover:text-strata-cyan transition-colors">Open-WebUI Front-End</a></li>
              <li><a href="/docs/api/#python" class="hover:text-strata-cyan transition-colors">Python SDK Client</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-mono font-bold text-white text-xs uppercase tracking-wider mb-3">Project Specs</h4>
            <p class="leading-relaxed mb-3">
              Released under the open-source <strong>MIT License</strong>. Free for personal, commercial, and research use.
            </p>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-strata-void border border-strata-border text-[11px] font-mono text-strata-emerald">
              <span class="w-1.5 h-1.5 rounded-full bg-strata-emerald animate-pulse"></span>
              Docs v1.4.0 • Updated October 2026
            </div>
          </div>
        </div>

        <div class="pt-8 border-t border-strata-border/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px]">
          <p>© 2026 stratallm.org • Unofficial Community Documentation &amp; Quickstart Hub.</p>
          <p class="text-slate-400 text-center sm:text-right max-w-xl">
            Strata is created by Niko1221. All model trademarks (Qwen, DeepSeek, Mixtral) belong to their respective corporate creators.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
