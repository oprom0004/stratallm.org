---
import Layout from '../layouts/Layout.astro';
import { HARDWARE_TIERS, BENCHMARKS_DATA } from '../data/docs';
import { STRATA_FAQS, strataFaqSchema } from '../data/faqs';

const pageTitle = 'Strata LLM – Run 125B+ MoE Models on 12GB VRAM Consumer GPUs (Docs & Setup)';
const pageDescription = 'Strata is an open-source local inference engine by Niko1221 that runs massive Mixture-of-Experts (MoE) models like Qwen3.8-Flash-Next on consumer PCs via dynamic offloading.';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Strata',
  alternateName: ['Strata LLM', 'Strata Inference Engine'],
  operatingSystem: 'Windows 10, Windows 11, Linux, WSL2',
  applicationCategory: 'DeveloperApplication',
  offers: {
    '@type': 'Offer',
    price: '0.00',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Person',
    name: 'Niko1221',
    url: 'https://github.com/Niko1221',
  },
  description: pageDescription,
  license: 'https://opensource.org/licenses/MIT',
  url: 'https://stratallm.org/',
};
---

<Layout title={pageTitle} description={pageDescription} schema={[softwareSchema, strataFaqSchema]}>
  
  <!-- Hero Section -->
  <section class="relative overflow-hidden border-b border-strata-border pt-12 pb-20 sm:pt-20 sm:pb-28">
    
    <!-- Background Gradient Circles -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[350px] bg-strata-cyan/15 blur-[120px] rounded-full pointer-events-none"></div>
    <div class="absolute top-1/3 right-10 w-[400px] h-[250px] bg-blue-600/10 blur-[100px] rounded-full pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-6">
        
        <!-- Live Tag -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-strata-cyan/10 border border-strata-cyan/30 text-strata-cyan text-xs font-mono font-bold tracking-wider uppercase">
          <span class="w-2 h-2 rounded-full bg-strata-cyan animate-ping"></span>
          <span>Open-Source Local MoE Inference Engine</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white font-mono tracking-tight leading-none">
          RUN <span class="text-transparent bg-clip-text bg-gradient-to-r from-strata-cyan via-blue-400 to-strata-emerald">125B+ MoE</span> ON CONSUMER GPUS
        </h1>

        <!-- Subheading -->
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-sans max-w-2xl">
          Powered by Niko1221's dynamic sparse router offloading. Run server-grade frontier models like <strong class="text-white">Qwen3.8-Flash-Next 125B</strong> on a single 12GB NVIDIA graphics card and 64GB system RAM—with zero cloud dependencies.
        </p>

        <!-- Quick Install Terminal Command Box -->
        <div class="pt-2">
          <div class="p-4 rounded-2xl bg-strata-card/90 border border-strata-border font-mono text-xs shadow-2xl space-y-2">
            <div class="flex items-center justify-between text-strata-muted border-b border-strata-border pb-2 text-[11px]">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
                <span class="text-slate-400 pl-2">One-Click Quickstart (Windows PowerShell / CMD)</span>
              </div>
              <span class="text-strata-emerald font-bold">MIT License</span>
            </div>
            <pre class="overflow-x-auto text-strata-cyan py-1 font-mono leading-relaxed select-all"><code>git clone https://github.com/Niko1221/Strata.git
cd Strata
.\START-HERE.bat</code></pre>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href="/docs/quickstart/"
            class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-strata-cyan to-blue-500 text-black font-mono font-bold text-xs uppercase tracking-wider shadow-glow-cyan hover:brightness-110 transition-all flex items-center gap-2"
          >
            <span>📖 Read Setup Guide</span>
            <span>→</span>
          </a>
          <a
            href="https://github.com/Niko1221/Strata"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 rounded-xl bg-strata-card hover:bg-slate-800 border border-strata-border text-white font-mono font-bold text-xs uppercase tracking-wider hover:border-strata-cyan transition-all flex items-center gap-2"
          >
            <span>⭐ View GitHub Repository</span>
            <span>↗</span>
          </a>
        </div>

        <!-- Spec Metric Badges -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t border-strata-border/80 text-xs font-mono">
          <div class="p-3 rounded-xl bg-strata-card/70 border border-strata-border">
            <span class="text-strata-muted block text-[10px] uppercase">Min GPU VRAM</span>
            <span class="text-white text-base font-bold">12 GB VRAM</span>
          </div>
          <div class="p-3 rounded-xl bg-strata-card/70 border border-strata-border">
            <span class="text-strata-muted block text-[10px] uppercase">Peak Speed</span>
            <span class="text-strata-cyan text-base font-bold">25 - 38 tok/s</span>
          </div>
          <div class="p-3 rounded-xl bg-strata-card/70 border border-strata-border">
            <span class="text-strata-muted block text-[10px] uppercase">API Standard</span>
            <span class="text-strata-emerald text-base font-bold">OpenAI &amp; Anthropic</span>
          </div>
          <div class="p-3 rounded-xl bg-strata-card/70 border border-strata-border">
            <span class="text-strata-muted block text-[10px] uppercase">Author</span>
            <span class="text-white text-base font-bold">Niko1221</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- How It Works: Architectural Overview -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-b border-strata-border">
    <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
      <span class="text-xs font-mono uppercase tracking-widest text-strata-cyan font-bold block">Engineering Architecture</span>
      <h2 class="text-3xl sm:text-4xl font-black font-mono text-white tracking-tight uppercase">
        How Strata Solves the VRAM Wall
      </h2>
      <p class="text-slate-400 text-sm font-sans">
        Traditional inference engines crash when a 125B model exceeds GPU memory. Strata utilizes the sparse nature of Mixture-of-Experts architectures to stream only active weights:
      </p>
    </div>

    <!-- Architecture 3-Step Flow Diagram -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="p-6 rounded-2xl bg-strata-card/80 border border-strata-border space-y-3 relative">
        <div class="w-10 h-10 rounded-xl bg-strata-cyan/15 border border-strata-cyan/30 flex items-center justify-center font-mono font-bold text-strata-cyan text-sm">
          01
        </div>
        <h3 class="font-mono font-bold text-white text-base">Predictive Sparse Routing</h3>
        <p class="text-slate-300 text-xs font-sans leading-relaxed">
          In MoE models like Qwen 125B, only 2-8 out of 64 experts fire per token. Strata predicts which expert layers will be called 1-2 tokens in advance, queuing them for instant DMA PCIe transfer.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-strata-card/80 border border-strata-border space-y-3 relative">
        <div class="w-10 h-10 rounded-xl bg-blue-500/15 border border-blue-500/30 flex items-center justify-center font-mono font-bold text-blue-400 text-sm">
          02
        </div>
        <h3 class="font-mono font-bold text-white text-base">Tiered VRAM-RAM Cache</h3>
        <p class="text-slate-300 text-xs font-sans leading-relaxed">
          Critical attention heads and frequently triggered experts reside permanently inside your 12GB GPU VRAM. The remaining 90GB of dormant weights stream through high-speed 64GB DDR5 memory.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-strata-card/80 border border-strata-border space-y-3 relative">
        <div class="w-10 h-10 rounded-xl bg-strata-emerald/15 border border-strata-emerald/30 flex items-center justify-center font-mono font-bold text-strata-emerald text-sm">
          03
        </div>
        <h3 class="font-mono font-bold text-white text-base">Zero-Copy Pinned Memory</h3>
        <p class="text-slate-300 text-xs font-sans leading-relaxed">
          Weights are transferred over asynchronous CUDA streams via PCIe 4.0/5.0 directly into tensor cores, completely bypassing CPU compute cycles and preventing stutter.
        </p>
      </div>

    </div>
  </section>

  <!-- Hardware Requirements Matrix -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-b border-strata-border">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-strata-emerald font-bold block mb-1">Hardware Blueprint</span>
        <h2 class="text-3xl sm:text-4xl font-black font-mono text-white tracking-tight uppercase">
          System Requirements Matrix
        </h2>
      </div>
      <span class="text-xs font-mono text-strata-muted">
        Tested on Windows 11 &amp; Ubuntu 24.04 LTS
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {HARDWARE_TIERS.map((tier) => (
        <div class="rounded-2xl bg-strata-card/85 border border-strata-border p-6 hover:border-strata-cyan/50 transition-all flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-0.5 rounded text-[10px] font-mono font-bold bg-strata-cyan/15 text-strata-cyan border border-strata-cyan/30">
                {tier.badge}
              </span>
              <span class="font-mono text-xs text-strata-muted font-bold">{tier.tier}</span>
            </div>

            <div class="space-y-2 text-xs font-mono">
              <div class="p-2.5 rounded-lg bg-strata-void border border-strata-border">
                <span class="text-strata-muted text-[10px] uppercase block">Graphics Card (GPU)</span>
                <strong class="text-white text-xs block">{tier.gpu}</strong>
                <span class="text-strata-cyan text-[11px]">{tier.vram}</span>
              </div>

              <div class="p-2.5 rounded-lg bg-strata-void border border-strata-border">
                <span class="text-strata-muted text-[10px] uppercase block">System RAM</span>
                <strong class="text-white text-xs block">{tier.ram}</strong>
              </div>

              <div class="p-2.5 rounded-lg bg-strata-void border border-strata-border">
                <span class="text-strata-muted text-[10px] uppercase block">Storage</span>
                <strong class="text-slate-300 text-xs block">{tier.storage}</strong>
              </div>

              <div class="p-2.5 rounded-lg bg-strata-emerald/10 border border-strata-emerald/30 text-strata-emerald">
                <span class="text-[10px] uppercase block font-bold">Estimated Generation Speed</span>
                <strong class="text-sm block">{tier.performance}</strong>
              </div>
            </div>
          </div>

          <div class="mt-5 pt-4 border-t border-strata-border/60 text-xs font-sans text-slate-400">
            <strong class="text-white text-[11px] block font-mono uppercase mb-1">Recommended Models:</strong>
            <ul class="space-y-0.5 text-[11px] list-disc list-inside">
              {tier.recommendedModels.map((m) => (
                <li>{m}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Performance Benchmarks Section -->
  <section id="benchmarks" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-b border-strata-border">
    <div class="max-w-3xl mb-10 space-y-2">
      <span class="text-xs font-mono uppercase tracking-widest text-strata-cyan font-bold block">Empirical Results</span>
      <h2 class="text-3xl sm:text-4xl font-black font-mono text-white tracking-tight uppercase">
        Engine Performance Comparison
      </h2>
      <p class="text-slate-400 text-sm font-sans">
        Testing Qwen3.8-Flash-Next (125 Billion Parameters) on a standard single RTX 4070 (12GB VRAM) paired with 64GB DDR5:
      </p>
    </div>

    <!-- Benchmark Table -->
    <div class="overflow-x-auto rounded-2xl border border-strata-border bg-strata-card/90 shadow-xl">
      <table class="w-full text-left font-mono text-xs">
        <thead class="bg-strata-void/80 border-b border-strata-border text-strata-muted uppercase text-[10px]">
          <tr>
            <th class="p-4">Inference Engine</th>
            <th class="p-4">Hardware Target</th>
            <th class="p-4">Tokens / Sec</th>
            <th class="p-4">RAM Allocation</th>
            <th class="p-4">Status &amp; Stability</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-strata-border/60">
          {BENCHMARKS_DATA.map((row) => (
            <tr class={row.engine.includes('Strata') ? 'bg-strata-cyan/5 font-semibold text-white' : 'text-slate-300'}>
              <td class="p-4 flex items-center gap-2">
                {row.engine.includes('Strata') && <span class="text-strata-cyan">⚡</span>}
                <span>{row.engine}</span>
              </td>
              <td class="p-4 text-slate-400">{row.hardware}</td>
              <td class="p-4">
                <span class={row.engine.includes('Strata') ? 'px-2 py-1 rounded bg-strata-emerald/20 text-strata-emerald font-bold' : 'text-slate-400'}>
                  {row.speed}
                </span>
              </td>
              <td class="p-4 text-slate-400">{row.ramUsage}</td>
              <td class="p-4">
                <span class={row.engine.includes('Strata') ? 'text-strata-cyan' : 'text-rose-400'}>
                  {row.status}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-12 space-y-2">
      <span class="text-xs font-mono uppercase tracking-widest text-strata-cyan font-bold block">Developer Q&amp;A</span>
      <h2 class="text-3xl sm:text-4xl font-black font-mono text-white tracking-tight uppercase">
        Frequently Asked Questions
      </h2>
      <p class="text-slate-400 text-sm font-sans">
        Everything you need to know about setting up Strata and configuring MoE quantization.
      </p>
    </div>

    <div class="space-y-4">
      {STRATA_FAQS.map((faq) => (
        <details class="group rounded-2xl bg-strata-card/80 border border-strata-border p-5 transition-all open:border-strata-cyan/50">
          <summary class="flex items-center justify-between cursor-pointer list-none font-mono font-bold text-white text-sm sm:text-base">
            <span>{faq.question}</span>
            <span class="ml-4 text-strata-cyan text-xl group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <div class="mt-4 pt-4 border-t border-strata-border/60 text-slate-300 text-xs sm:text-sm font-sans leading-relaxed">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </section>

</Layout>
